{
    "name": "@llumiverse/drivers",
    "version": "1.6.0-dev.20261022.120426Z",
    "type": "module",
    "description": "LLM driver implementations. Currently supported are: openai, huggingface, bedrock, replicate.",
    "files": [
        "lib",
        "src"
    ],
    "main": "./lib/index.js",
    "types": "./lib/index.d.ts",
    "exports": {
        "./embedding-batch": {
            "types": "./lib/embedding-batch.d.ts",
            "default": "./lib/embedding-batch.js"
        },
        "./factory": {
            "types": "./lib/factory.d.ts",
            "default": "./lib/factory.js"
        },
        "./driver-options": {
            "types": "./lib/driver-options.d.ts",
            "default": "./lib/driver-options.js"
        },
        ".": {
            "types": "./lib/index.d.ts",
            "default": "./lib/index.js"
        },
        "./openai": {
            "types": "./lib/openai/drivers.d.ts",
            "default": "./lib/openai/drivers.js"
        },
