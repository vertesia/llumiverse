            "default": "./lib/index.js"
        },
        "./schemas": {
            "types": "./lib/schemas/index.d.ts",
            "default": "./lib/schemas/index.js"
        },
        "./json-schema": "./json-schema/llumiverse.schema.json"
    },
    "scripts": {
        "lint": "biome lint src",
