{
    "name": "@llumiverse/parent",
    "version": "1.6.0-dev.20261022.120426Z",
    "private": true,
    "type": "module",
    "scripts": {
        "build": "pnpm exec turbo run build ${TURBO_CACHE_OPTS:---cache=local:rw,remote:r}",
        "check": "pnpm exec biome check .",
        "check:write": "pnpm exec biome check --write .",
        "ci:local": "pnpm run ci:renovate && pnpm run check && pnpm run build && pnpm run typecheck:test && pnpm run test:unit",
        "ci:renovate": "npx --yes --package renovate@44.168.1 -- renovate-config-validator --strict",
        "clean:outputs": "pnpm -r exec rimraf ./lib ./dist ./.next ./tsconfig.tsbuildinfo ./.tsbuildinfo",
        "format": "pnpm exec biome format --write .",
        "format:check": "pnpm exec biome format .",
        "lint": "pnpm exec biome lint",
        "lint:actions": "scripts/run-actionlint.sh",
        "lint:fix": "pnpm exec biome lint --write",
        "prepare": "cp ./README.md ./core/ && cp ./README.md ./drivers/ && git config core.hooksPath .githooks 2>/dev/null || true",
        "release": "pnpm -r publish --access public",
        "test": "pnpm exec turbo run test",
        "typecheck:test": "pnpm exec turbo run typecheck:test ${TURBO_CACHE_OPTS:---cache=local:rw,remote:r}",
        "test:unit": "pnpm exec turbo run test:unit ${TURBO_CACHE_OPTS:---cache=local:rw,remote:r}"
    },
    "devDependencies": {
        "@biomejs/biome": "2.5.15",
        "turbo": "^2.11.8",
        "typescript": "catalog:",
        "vitest": "catalog:"
    },
    "packageManager": "pnpm@12.14.0",
    "gitHead": "1c5d8982ba36aaa1ab1bb76162845690492ef46c",
    "releaseIdentity": {
        "source_sha": "1c5d8982ba36aaa1ab1bb76162845690492ef46c",
        "dependency_sha": "",
        "lock_sha256": "d7263c7c8fc749f233a5362f162186fd66d341776955bede0f5dd63ce31c623f"
    }
}
