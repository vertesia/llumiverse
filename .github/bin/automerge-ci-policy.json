{
    "build-and-test.yml": {
        "workflow": "pr-validation.yaml",
        "fallbackWorkflows": ["build-and-test.yml"],
        "jobs": [
            {
                "name": "^(Build and test / )?Build and test( \\(.*\\))?$",
                "example": "Build and test / Build and test",
                "steps": [
                    "Build workspace",
                    "Typecheck and functional tests",
                    "Curated live provider smoke tests"
                ]
            }
        ]
    },
    "lint.yml": {
        "workflow": "pr-validation.yaml",
        "fallbackWorkflows": ["lint.yml"],
        "jobs": [
            {
                "name": "^(Lint / )?Check codebase$",
                "example": "Lint / Check codebase",
                "steps": [
                    "Test automerge CI policy",
                    "Check codebase"
                ]
            }
        ]
    }
}
