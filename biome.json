{
    "$schema": "https://biomejs.dev/schemas/2.6.3/schema.json",
    "vcs": {
        "enabled": true,
        "clientKind": "git",
        "useIgnoreFile": true
    },
    "files": {
        "ignoreUnknown": true,
        "includes": [
            "**/package.json",
            "**/*.{js,cjs,mjs,jsx,ts,tsx}",
            "**/*.{md,yml,yaml}",
            "!**/pnpm-lock.yaml",
            "!**/pnpm-workspace.yaml",
            "!**/templates/**/*.{yml,yaml}",
            "!**/dist/**",
            "!**/lib/**",
            "!**/node_modules/**",
            "!**/build/**",
            "!**/bin/**",
            ".github/bin/ci-approve*.mjs"
        ]
    },
    "formatter": {
        "enabled": true,
        "indentStyle": "space",
        "indentWidth": 4,
        "lineWidth": 120
    },
    "linter": {
        "enabled": true,
        "rules": {
            "preset": "recommended",
            "correctness": {
                "noEmptyPattern": "error",
                "noUnreachable": "error",
                "noUnusedFunctionParameters": "error",
                "noUnusedImports": "error",
                "noUnusedVariables": "error",
                "noVoidTypeReturn": "error",
                "useJsxKeyInIterable": "error",
                "useParseIntRadix": "error"
            },
            "complexity": {
                "useLiteralKeys": "error",
                "useOptionalChain": "error",
                "noUnnecessaryTemplateExpression": "error",
                "useArraySome": "error",
                "useMathMinMax": "error",
                "useRegexpTest": "error"
            },
            "security": {
                "noDangerouslySetInnerHtml": "error",
                "useIframeSandbox": "error"
            },
            "style": {
                "useImportType": "error",
                "useNodejsImportProtocol": "error",
                "useTemplate": "error",
                "useReduceTypeParameter": "error"
            },
            "suspicious": {
                "noControlCharactersInRegex": "error",
                "noDeprecatedImports": "error",
                "noDoubleEquals": "error",
                "noExplicitAny": "error",
                "noImplicitAnyLet": "error",
                "noShadowRestrictedNames": "error",
                "noTemplateCurlyInString": "off",
                "noUnusedExpressions": "error",
                "useBiomeIgnoreFolder": "off",
                "useIterableCallbackReturn": "error",
                "noImportCycles": "error",
                "noDuplicateSelectors": "error",
                "noEmptyObjectKeys": "error",
                "noIdenticalTestTitle": "error",
                "noJsxLeakedDollar": "error"
            },
            "performance": {
                "useDomNodeTextContent": "error"
            },
            "nursery": {
                "noFloatingPromises": "error",
                "noMisusedPromises": "error",
                "noAccidentalBitwiseOperators": "error",
                "noArgumentsCallerOrCallee": "error",
                "noArraySortForMinMax": "error",
                "noBooleanSortComparator": "error",
                "noDoubleComparison": "error",
                "noDuplicateMapKeys": "error",
                "noNewRequire": "error",
                "noObjectConstructor": "error",
                "noObsoleteAttributes": "error",
                "noOctal": "error",
                "noPathConcat": "error",
                "noSelfNestedLayer": "error",
                "noTailwindLegacyUtilities": "error",
                "noUnsafeUnaryMinus": "error",
                "noUselessCall": "error",
                "noUselessDateGetTime": "error",
                "noUselessSplice": "error",
                "useConsistentHeadingLevel": "error",
                "useFencedCodeLanguage": "error",
                "useMathAbs": "error",
                "usePackageJsonValidCpu": "error",
                "usePackageJsonValidEngines": "error",
                "useSimplifiedBooleanReturn": "error",
                "useSingleTopLevelHeading": "error",
                "useTopLevelHeading": "error"
            }
        }
    },
    "javascript": {
        "formatter": {
            "quoteStyle": "single"
        }
    },
    "markdown": {
        "parser": {
            "frontmatter": true
        },
        "formatter": {
            "formatEmbeds": false
        }
    },
    "yaml": {
        "formatter": {
            "indentWidth": 2
        }
    },
    "assist": {
        "enabled": true,
        "actions": {
            "source": {
                "organizeImports": "on"
            }
        }
    },
    "overrides": [
        {
            "includes": ["AGENTS.md"],
            "linter": {
                "rules": {
                    "nursery": {
                        "useSingleTopLevelHeading": "off"
                    }
                }
            }
        },
        {
            "includes": [".github/**/*.md", "**/.claude/agents/**/*.md"],
            "linter": {
                "rules": {
                    "nursery": {
                        "useTopLevelHeading": "off"
                    }
                }
            }
        }
    ]
}
